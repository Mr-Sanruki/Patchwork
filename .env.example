# ==============================================================================
# Patchwork: Dependency upgrades that fix themselves, and prove it.
# Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Nebius Token Factory (NVIDIA Nemotron Models - OpenAI Compatible)
# ------------------------------------------------------------------------------
# Your Nebius Token Factory API key. Required for multi-agent reasoning.
NEBIUS_API_KEY=your_nebius_api_key_here

# Base URL for Nebius Token Factory API
# Default: https://api.studio.nebius.ai/v1 (or https://api.tokenfactory.nebius.ai/v1)
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# Three-tier Nemotron Model selection (or configured at runtime via GET /v1/models)
# Tier 1: Nano (Fast triage, breaking change summarization, affected files analysis)
NEMOTRON_NANO_MODEL=nvidia/nemotron-mini-4b-instruct

# Tier 2: Super (Parallel candidate patch generation & repair iterations)
NEMOTRON_SUPER_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# Tier 3: Ultra (Deep reasoning, winning patch review, risk assessment, PR writing)
NEMOTRON_ULTRA_MODEL=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# ------------------------------------------------------------------------------
# 2. Tavily Search & Extract (Migration Guides, Changelogs & Docs)
# ------------------------------------------------------------------------------
# Tavily API key for live search and changelog extraction
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ------------------------------------------------------------------------------
# 3. Sandbox Test Execution (Nebius Jobs vs. Local Docker)
# ------------------------------------------------------------------------------
# Runner selection: "docker" (local fallback) or "nebius" (Nebius Serverless Jobs)
SANDBOX_RUNNER=docker

# Nebius Serverless Jobs credentials (if SANDBOX_RUNNER=nebius)
NEBIUS_PROJECT_ID=
NEBIUS_IAM_TOKEN=
NEBIUS_JOBS_ENDPOINT=https://api.serverless.nebius.ai/v1

# Local Docker settings (if SANDBOX_RUNNER=docker)
DOCKER_IMAGE=node:20-alpine
DOCKER_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 4. GitHub Integration (PR Delivery & Verification)
# ------------------------------------------------------------------------------
# Optional: GitHub Personal Access Token (PAT) with repo scope
# If omitted or empty, Patchwork operates in fallback mode (downloadable .patch + PR preview)
GITHUB_TOKEN=

# ------------------------------------------------------------------------------
# 5. Pipeline Configuration
# ------------------------------------------------------------------------------
# Number of parallel candidate patches to generate per attempt (default: 4)
CANDIDATE_COUNT=4

# Maximum repair feedback loops if all initial candidates fail tests (default: 3)
MAX_REPAIR_ROUNDS=3

# Server Settings
PORT=3001
HOST=0.0.0.0
FRONTEND_PORT=5173
NODE_ENV=development
DATABASE_PATH=./data/patchwork.db
